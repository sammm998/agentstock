# ---------------------------------------------------------------- core
# Leave empty to use the embedded Postgres (PGlite) in apps/web/.data. Set to a Postgres/Supabase URL in production.
DATABASE_URL=
# Comma-separated emails that receive the platform admin role when they sign up.
HUSTERA_ADMIN_EMAILS=
# Public base URL, used for payment redirects (e.g. https://hustera.app). Optional locally.
HUSTERA_BASE_URL=

# ---------------------------------------------------------------- payments (Milestone C)
# Stripe test key (sk_test_…). Live keys are refused unless HUSTERA_ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUSTERA_ALLOW_LIVE_PAYMENTS=
# Allow the simulated test checkout in production builds (staging/demo only).
HUSTERA_TEST_PAYMENTS=

# ---------------------------------------------------------------- AI model (Milestone D)
# Anthropic is preferred if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUSTERA_LLM_MODEL=
HUSTERA_LLM_INPUT_CENTS_PER_MTOK=
HUSTERA_LLM_OUTPUT_CENTS_PER_MTOK=

# ---------------------------------------------------------------- Composio (Milestone F) — see docs/composio.md
COMPOSIO_API_KEY=
# JSON map of toolkit → auth config id, e.g. {"shopify":"ac_123"}
COMPOSIO_AUTH_CONFIGS=
# Toolkit and tool used by the "Publish to external store" mission step.
COMPOSIO_PUBLISH_TOOLKIT=
COMPOSIO_PUBLISH_TOOL=

# ---------------------------------------------------------------- email
# Resend API key for transactional email (password reset). Without it, emails stay in the outbox (/dev/outbox in development).
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------- background worker
# Bearer secret for POST /api/cron/agents (advances autonomous missions).
CRON_SECRET=
