# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored in apps/web/.data.
# Set it to a Postgres/Supabase connection string in production.
DATABASE_URL=
# Comma-separated emails that receive the platform admin role when they sign up.
HUSTERA_ADMIN_EMAILS=
# Optional: Composio project API key. Without it, Composio capabilities show CONNECT_REQUIRED.
COMPOSIO_API_KEY=
